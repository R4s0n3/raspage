# Copy to .env. Everything here is built into the app and readable by
# anyone who has it: no secrets. The OpenRouter key belongs in
# server/.env at the repository root, never here.

# Where server.js runs. A phone needs your computer's network address.
EXPO_PUBLIC_MOODPAGE_API=http://localhost:8787
# Only if the server sets MOODPAGE_APP_TOKEN.
# EXPO_PUBLIC_MOODPAGE_TOKEN=
