# Copy to server/.env for local runs. Never commit it.
# The key that turns diary entries into weather (POST /api/mood).
OPENROUTER_API_KEY=
# Optional: another OpenRouter model with structured outputs.
# MOODPAGE_MODEL=anthropic/claude-opus-5.5
# Optional: a shared token the app must send (EXPO_PUBLIC_MOODPAGE_TOKEN).
# MOODPAGE_APP_TOKEN=
