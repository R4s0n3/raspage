# Copy to server/.env for local runs. Never commit it.
# The key that turns diary entries into weather (POST /api/mood).
OPENROUTER_API_KEY=
# Optional: another OpenRouter model with structured outputs.
# anthropic/claude-haiku-5.5 makes a mood in about 4-8 s for a fraction of a
# cent; openrouter/free is too unreliable for the mood's strict format.
# MOODPAGE_MODEL=anthropic/claude-opus-5.5
# Optional: how long the model thinks first (low, medium, high).
# MOODPAGE_EFFORT=low
# Accounts and friends (Postgres). On Coolify: the internal URL of a
# PostgreSQL resource. Locally: `npm run db:dev --workspace server` runs
# one (PGlite, data in server/.pglite) on port 5433:
# DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres
# Optional, only without a database: a shared token the app must send
# (EXPO_PUBLIC_MOODPAGE_TOKEN).
# MOODPAGE_APP_TOKEN=

# Links that open the app (https://<domain>/invite/...). Each file is only
# published once its value is set.
# Apple: your Team ID (developer.apple.com → Membership details).
# APPLE_TEAM_ID=
# Android: the app signing certificate's SHA-256 (eas credentials -p android),
# comma-separated if several.
# ANDROID_CERT_SHA256=
# The bundle ID / package, if they ever differ from mobile/app.json.
# IOS_BUNDLE_ID=de.therascal.moodpage
# ANDROID_PACKAGE=de.therascal.moodpage
# Shown on invite pages as "Get the app" (e.g. a TestFlight public link).
# APP_INSTALL_URL=
# A contact address shown on /privacy (the App Store asks for one).
# MOODPAGE_CONTACT=
